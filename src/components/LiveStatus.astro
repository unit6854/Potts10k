---
import Icon from './Icon.astro';
const { data } = Astro.props;
const {
  heading, isLive, liveLabel, platform, platformUrl, onLabel, currentlyLabel,
  nowPlaying, nowPlayingSub, followersLabel, followers, goalLabel, goalPercent = 0,
} = data;
---
<section id="live" class="panel block">
  <div class="head">
    <h2 class="section-label">{heading}</h2>
    {isLive && <span class="live-badge"><i></i>{liveLabel}</span>}
  </div>

  <a class="screen" href={platformUrl} target="_blank" rel="noopener">
    <span class="on">{onLabel}</span>
    <span class="glyph"><Icon name={platform.toLowerCase()} size={40} /></span>
  </a>

  <div class="now">
    <span class="lbl">{currentlyLabel}</span>
    <strong>{nowPlaying}</strong>
    <span class="sub">{nowPlayingSub}</span>
  </div>

  <div class="followers">
    <span class="lbl">{followersLabel}</span>
    <div class="num">{followers}</div>
    <span class="goal">{goalLabel}</span>
    <div class="bar"><span style={`width:${goalPercent}%`}></span></div>
  </div>
</section>

<style>
  .block { padding: 16px 18px 20px; }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .live-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-display); font-weight: 700; font-size: 0.6rem; letter-spacing: 0.12em;
    color: #fff; background: var(--live);
    padding: 3px 8px; border-radius: 5px;
    box-shadow: 0 0 14px rgba(255, 59, 70, 0.6);
  }
  .live-badge i { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: blink 1.2s infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  .screen {
    position: relative;
    display: grid; place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    margin-bottom: 16px;
    color: #b48bff;
    background: radial-gradient(circle at 50% 55%, rgba(60, 30, 120, 0.55), rgba(6, 14, 34, 0.9));
    border: 1px solid rgba(120, 90, 220, 0.45);
    box-shadow: inset 0 0 30px rgba(80, 40, 160, 0.4), 0 0 18px rgba(80, 40, 160, 0.25);
    overflow: hidden;
  }
  .screen .glyph { filter: drop-shadow(0 0 16px rgba(150, 90, 255, 0.9)); animation: pulse 2.6s ease-in-out infinite; }
  @keyframes pulse { 50% { transform: scale(1.08); filter: drop-shadow(0 0 26px rgba(150, 90, 255, 1)); } }
  .on {
    position: absolute; top: 12px;
    font-family: var(--font-display); font-size: 0.62rem; letter-spacing: 0.16em;
    color: var(--accent-bright);
  }

  .now { text-align: center; margin-bottom: 16px; }
  .now .lbl, .followers .lbl {
    display: block; font-family: var(--font-display); font-size: 0.58rem;
    letter-spacing: 0.16em; color: var(--text-dim); margin-bottom: 4px;
  }
  .now strong { font-family: var(--font-display); font-size: 0.92rem; color: #eaf6ff; }
  .now .sub { display: block; font-size: 0.74rem; color: var(--text-dim); }

  .followers { text-align: center; }
  .num {
    font-family: var(--font-num); font-weight: 900;
    font-size: 2.4rem; line-height: 1; color: #fff;
    text-shadow: 0 0 22px rgba(47, 139, 255, 0.8);
    margin: 2px 0 6px;
  }
  .goal { display: block; font-size: 0.6rem; letter-spacing: 0.14em; color: var(--text-faint); margin-bottom: 6px; }
  .bar { height: 7px; border-radius: 5px; background: rgba(10, 30, 70, 0.8); overflow: hidden; border: 1px solid rgba(47, 139, 255, 0.25); }
  .bar span {
    display: block; height: 100%;
    background: linear-gradient(90deg, #2f9bff, #6cc4ff);
    box-shadow: 0 0 12px rgba(47, 139, 255, 0.8);
  }
</style>
