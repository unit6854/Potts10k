---
import Icon from './Icon.astro';
const { data } = Astro.props;
const { heading, avatar, body, followLabel, followUrl, subscribeLabel, subscribeUrl } = data;
---
<section id="about" class="panel block">
  <h2 class="section-label">{heading}</h2>
  <div class="row">
    <img class="ava" src={avatar} alt="avatar" width="92" height="92" loading="lazy" />
    <div class="content">
      <p>{body}</p>
      <div class="actions">
        <a class="btn btn-primary" href={followUrl} target="_blank" rel="noopener"><Icon name="heart" size={15} />{followLabel}</a>
        <a class="btn btn-ghost" href={subscribeUrl} target="_blank" rel="noopener"><Icon name="star" size={15} />{subscribeLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .block { padding: 16px 18px 20px; height: 100%; }
  .section-label { margin-bottom: 14px; }
  .row { display: flex; gap: 16px; align-items: flex-start; }
  .ava {
    flex: 0 0 auto;
    width: 92px; height: 92px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(108, 196, 255, 0.6);
    box-shadow: 0 0 18px rgba(47, 139, 255, 0.5);
  }
  p { margin: 0 0 14px; font-size: 0.86rem; color: #c2ddf7; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 460px) { .row { flex-direction: column; align-items: center; text-align: center; } }
</style>
