---
// GPU-driven hero backdrop: animated blue energy field (fbm + domain warp)
// with descending pixel-dissolve columns. All visual cost is on the GPU; the
// canvas renders at reduced internal resolution and the loop is FPS-capped and
// paused when off-screen.
---
<canvas id="hero-gl" aria-hidden="true"></canvas>

<style>
  #hero-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    /* CSS fallback shown until/unless WebGL paints */
    background:
      radial-gradient(60% 55% at 50% 42%, rgba(28, 92, 190, 0.55), transparent 70%),
      radial-gradient(90% 80% at 50% 30%, rgba(10, 40, 95, 0.5), transparent 75%);
  }
  @media (prefers-reduced-motion: reduce) {
    #hero-gl { /* keep the static gradient, no JS animation */ }
  }
</style>

<script>
  const canvas = document.getElementById('hero-gl') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: true, premultipliedAlpha: false });
    if (gl) initGL(gl, canvas);
  }

  function initGL(gl: WebGLRenderingContext, canvas: HTMLCanvasElement) {
    const vert = `
      attribute vec2 p;
      void main() { gl_Position = vec4(p, 0.0, 1.0); }
    `;
    const frag = `
      precision mediump float;
      uniform vec2 u_res;
      uniform float u_time;

      // hash / value-noise / fbm
      float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
      float noise(vec2 p){
        vec2 i = floor(p), f = fract(p);
        vec2 u = f*f*(3.0-2.0*f);
        return mix(mix(hash(i), hash(i+vec2(1.0,0.0)), u.x),
                   mix(hash(i+vec2(0.0,1.0)), hash(i+vec2(1.0,1.0)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0.0, a = 0.5;
        for(int i=0;i<5;i++){ v += a*noise(p); p *= 2.02; a *= 0.5; }
        return v;
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p = uv;
        p.x *= u_res.x / u_res.y;          // aspect correct
        float t = u_time * 0.06;

        // domain-warped fbm → flowing energy
        vec2 q = vec2(fbm(p*2.0 + t), fbm(p*2.0 - t + 5.2));
        float f = fbm(p*3.0 + q*1.8 + vec2(0.0, t*1.5));

        // glow concentrated behind the centre/logo
        vec2 c = uv - vec2(0.5, 0.46);
        c.x *= u_res.x / u_res.y;
        float core = exp(-dot(c, c) * 5.5);

        // blue palette
        vec3 deep   = vec3(0.012, 0.035, 0.10);
        vec3 mid    = vec3(0.04, 0.22, 0.62);
        vec3 bright = vec3(0.35, 0.70, 1.0);
        vec3 col = deep;
        col = mix(col, mid, smoothstep(0.25, 0.85, f));
        col += bright * pow(f, 3.0) * 0.6;
        col += bright * core * 0.9;

        // electric filaments
        float fil = smoothstep(0.55, 0.62, f) - smoothstep(0.62, 0.70, f);
        col += vec3(0.4, 0.75, 1.0) * fil * 0.5;

        // ---- descending pixel-dissolve columns (top-weighted) ----
        float cols = 60.0;
        float cx = floor(uv.x * cols);
        float colHash = hash(vec2(cx, 1.0));
        float speed = 0.25 + colHash * 0.5;
        float rows = 90.0;
        float ry = uv.y * rows + u_time * speed * 10.0;
        float cell = hash(vec2(cx, floor(ry)));
        float px = step(0.86, cell);                       // sparse lit pixels
        float topFade = smoothstep(1.0, 0.45, uv.y);       // only near the top
        float blocky = step(0.5, fract(uv.x * cols)) * step(0.5, fract(ry));
        col += vec3(0.5, 0.8, 1.0) * px * topFade * 0.55 * (0.6 + blocky*0.4);

        // vignette + alpha so the section bg shows at edges
        float vig = smoothstep(1.15, 0.25, length(uv - 0.5));
        col *= vig;
        float alpha = clamp(0.30 + f*0.5 + core*0.7 + px*topFade*0.5, 0.0, 1.0);
        gl_FragColor = vec4(col, alpha);
      }
    `;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'u_res');
    const uTime = gl.getUniformLocation(prog, 'u_time');
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    const SCALE = 0.6; // render below display res → cheap, glow hides it
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const w = Math.max(1, Math.floor(canvas.clientWidth * dpr * SCALE));
      const h = Math.max(1, Math.floor(canvas.clientHeight * dpr * SCALE));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    }
    window.addEventListener('resize', resize);
    resize();

    // pause when off-screen / tab hidden
    let visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }, { threshold: 0 }).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) last = performance.now(); });

    const FPS = 32, frameMs = 1000 / FPS;
    let last = performance.now(), acc = 0, start = performance.now();
    function loop(now: number) {
      requestAnimationFrame(loop);
      if (!visible || document.hidden) { last = now; return; }
      acc += now - last;
      last = now;
      if (acc < frameMs) return;
      acc = 0;
      resize();
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, (now - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    requestAnimationFrame(loop);
  }
</script>
