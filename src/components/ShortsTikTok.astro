---
import Icon from './Icon.astro';
import { resolveThumb, resolveTitle } from '../lib/tiktok.mjs';
const { data } = Astro.props;
const { heading, viewAllLabel, viewAllUrl, items = [] } = data;

// Resolve thumbnails/titles from the build-time TikTok cache.
const clips = items.map((it: any) => ({
  ...it,
  thumb: resolveThumb(it.thumbnail, it.tiktokUrl),
  displayTitle: resolveTitle(it.title, it.tiktokUrl, it.game || 'Clip'),
  game: it.game || '',
}));

// Build the filter tabs from the games present (preserve first-seen order).
const games: string[] = [];
for (const c of clips) if (c.game && !games.includes(c.game)) games.push(c.game);
const tabs = ['All', ...games];
---
<section id="shorts" class="panel block">
  <div class="head">
    <h2 class="section-label"><Icon name="tiktok" size={17} class="ico" />{heading}</h2>
    <a class="view-all" href={viewAllUrl} target="_blank" rel="noopener">{viewAllLabel}</a>
  </div>

  {tabs.length > 1 && (
    <div class="tabs" role="tablist">
      {tabs.map((t, i) => (
        <button class={`tab ${i === 0 ? 'active' : ''}`} data-filter={t === 'All' ? '' : t} type="button">{t}</button>
      ))}
    </div>
  )}

  <div class="reel">
    {clips.map((v: any) => (
      <a class="short" href={v.tiktokUrl} target="_blank" rel="noopener" data-game={v.game} data-clip={v.previewClip || ''}>
        <div class="media">
          <img class="poster" src={v.thumb} alt={v.displayTitle} loading="lazy" />
          {v.previewClip && (
            <video class="prev" muted loop playsinline preload="none" poster={v.thumb}>
              <source src={v.previewClip} />
            </video>
          )}
          <span class="scan" aria-hidden="true"></span>
          {v.game && <span class="tag">{v.game}</span>}
          <span class="tt" aria-hidden="true"><Icon name="tiktok" size={13} /></span>
        </div>
        {v.displayTitle && <span class="title clamp-1">{v.displayTitle}</span>}
      </a>
    ))}
  </div>
</section>

<style>
  .block { padding: 16px 18px 20px; }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }

  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .tab {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    background: rgba(7, 16, 38, 0.6);
    border: 1px solid rgba(47, 139, 255, 0.22);
    padding: 6px 13px;
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .tab:hover { color: var(--accent-bright); border-color: rgba(108, 196, 255, 0.5); }
  .tab.active {
    color: #eaf6ff;
    background: linear-gradient(180deg, rgba(47, 139, 255, 0.35), rgba(12, 60, 160, 0.25));
    border-color: rgba(108, 196, 255, 0.7);
    box-shadow: 0 0 16px rgba(47, 139, 255, 0.4);
  }

  .reel { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }

  .short { display: block; transition: transform 0.18s, opacity 0.25s; }
  .short:hover { transform: translateY(-4px); }
  .short.hidden { display: none; }

  .media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid rgba(108, 196, 255, 0.3);
    box-shadow: 0 0 16px rgba(10, 40, 100, 0.3);
    background: #04101f;
  }
  .poster, .prev { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster { transition: transform 0.5s, filter 0.3s; }
  .prev { opacity: 0; transition: opacity 0.25s; }
  .short:hover .poster { transform: scale(1.08); filter: brightness(1.06); }
  .short.playing .prev { opacity: 1; }

  .scan {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 40%, rgba(120, 200, 255, 0.28) 50%, transparent 60%);
    transform: translateX(-120%);
  }
  .short:hover .scan { animation: sweep 0.9s ease-in-out; }
  @keyframes sweep { to { transform: translateX(120%); } }

  .tag {
    position: absolute; left: 7px; top: 7px;
    max-width: calc(100% - 38px);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.02em;
    padding: 3px 7px; border-radius: 5px;
    background: rgba(4, 10, 26, 0.82);
    color: #bfe0ff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tt {
    position: absolute; right: 7px; bottom: 7px;
    display: grid; place-items: center;
    width: 22px; height: 22px; border-radius: 6px;
    background: rgba(4, 10, 26, 0.82);
    color: var(--accent-bright);
  }
  .title {
    display: block; margin-top: 8px;
    font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.03em;
    color: var(--text);
  }

  @media (max-width: 900px) { .reel { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 460px) { .reel { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
  // Game filter tabs
  document.querySelectorAll<HTMLElement>('#shorts').forEach((section) => {
    const tabs = section.querySelectorAll<HTMLButtonElement>('.tab');
    const cards = section.querySelectorAll<HTMLElement>('.short');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.dataset.filter || '';
        cards.forEach((c) => {
          c.classList.toggle('hidden', !!filter && c.dataset.game !== filter);
        });
      });
    });

    // Hover → play uploaded preview clip if one exists
    cards.forEach((el) => {
      const vid = el.querySelector<HTMLVideoElement>('.prev');
      if (!vid) return;
      el.addEventListener('mouseenter', () => { el.classList.add('playing'); vid.play().catch(() => {}); });
      el.addEventListener('mouseleave', () => { el.classList.remove('playing'); vid.pause(); vid.currentTime = 0; });
    });
  });
</script>
