---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NavBar from '../components/NavBar.astro';
import FeaturedVideos from '../components/FeaturedVideos.astro';
import ShortsTikTok from '../components/ShortsTikTok.astro';
import AboutMe from '../components/AboutMe.astro';
import StreamSchedule from '../components/StreamSchedule.astro';
import LiveStatus from '../components/LiveStatus.astro';
import StayConnected from '../components/StayConnected.astro';
import LatestUpdates from '../components/LatestUpdates.astro';
import Footer from '../components/Footer.astro';
import data from '../data/homepage.json';
---
<BaseLayout title={data.site.title} description={data.site.description}>
  <Hero topbar={data.topbar} />
  <NavBar items={data.nav} />

  <main class="container layout">
    <div class="col-main">
      <FeaturedVideos data={data.featured} />
      <ShortsTikTok data={data.shorts} />
      <div class="about-schedule">
        <AboutMe data={data.about} />
        <StreamSchedule data={data.schedule} />
      </div>
    </div>

    <aside class="col-side">
      <LiveStatus data={data.live} />
      <StayConnected data={data.connect} />
    </aside>
  </main>

  <section class="container updates-wrap">
    <LatestUpdates data={data.updates} />
  </section>

  <Footer copyright={data.site.copyright} />
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;
    align-items: start;
    margin-top: 20px;
  }
  .col-main { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .col-side { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 70px; }
  .about-schedule { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; }
  .updates-wrap { margin-top: 18px; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .col-side { position: static; flex-direction: row; flex-wrap: wrap; }
    .col-side > :global(*) { flex: 1 1 280px; }
  }
  @media (max-width: 620px) {
    .about-schedule { grid-template-columns: 1fr; }
  }
</style>
